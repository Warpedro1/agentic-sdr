# Copie para .env e ajuste. O .env nunca vai para o git.

DATABASE_URL=postgresql+psycopg://marina:marina@localhost:5432/marina

# Agendamento
ANTECEDENCIA_MINIMA_HORAS=2
HORIZONTE_DIAS=7
SLOTS_OFERTADOS=5

# Conversa
MAX_TENTATIVAS=3
JANELA_RETOMADA_HORAS=24

# Documentos
STORAGE_DIR=storage
# 16 MiB: o teto da Twilio por mensagem.
DOC_MAX_BYTES=16777216
DOC_EXTENSOES=pdf,jpg,jpeg,png,doc,docx

# CRM externo (hoje o `juridico`)
#
# Cada instalacao do juridico e UMA empresa. A Marina atende varias, e o cadastro
# de cada uma vive no banco:
#
#   python scripts/cadastrar_empresa.py --slug acme \
#       --whatsapp "+5511999990000" --base-url "https://acme.juridico.com.br"
#   python scripts/cadastrar_empresa.py --listar
#
# A CREDENCIAL DE CADA EMPRESA NAO VAI PARA O BANCO. Ela mora aqui, numa variavel
# derivada do slug, e o banco guarda so o NOME dela. Uma coluna com o token
# apareceria em pg_dump, em replica e em qualquer SELECT — e dumps de
# desenvolvimento circulam entre maquinas.
#
#   JURIDICO_TOKEN_ACME=1|...
#   JURIDICO_TOKEN_LEVE=1|...
#
# Cadastrar empresa exige reiniciar o processo. E o preco aceito pelo sigilo, e e
# menor do que parece: cadastrar ja exige gerar o token no juridico dela e apontar
# um numero de WhatsApp para o webhook.

# Chave geral: `false` desliga a integracao de TODAS as empresas de uma vez.
# E o desligamento de emergencia, nao o interruptor do dia a dia — quem liga e
# desliga uma empresa e o cadastro dela.
JURIDICO_ATIVO=false
# O juridico local sobe na 8000 (php artisan serve).
JURIDICO_BASE_URL=http://127.0.0.1:8000
# Token do usuario de servico. Gere no juridico com:
#
#   php artisan integracao:usuario "Nome da Empresa"
#
# O comando cria um perfil com SO duas permissoes (comercial.negociacoes e
# comercial.tarefas) e imprime o token uma unica vez. A empresa e o alcance vem
# do cadastro de la, nao daqui.
#
# A negociacao e a reuniao nascem no nome desse usuario: e assim que "em aberto"
# se representa no juridico, ja que toda tarefa exige um responsavel. Alguem do
# time assume depois.
JURIDICO_TOKEN=
JURIDICO_TIMEOUT_S=15
# Aparece escrito na observacao registrada no CRM.
JURIDICO_CANAL_CONTATO=WhatsApp
OUTBOX_MAX_TENTATIVAS=5

# WhatsApp via Twilio
# Do Console da Twilio (painel inicial). O auth token e o segredo que assina os
# webhooks: sem conferir a assinatura, quem descobrir o endereco publico cria lead
# e reuniao falsos no juridico.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Fase 1 (sandbox): o numero compartilhado da Twilio, +14155238886.
# Fase 2: o numero do escritorio, ja aprovado como WhatsApp Sender.
TWILIO_WHATSAPP_FROM=
# O endereco publico EXATO que esta no Console, sem barra no fim. A assinatura e
# calculada sobre a URL completa — o endereco do ngrok muda a cada reinicio, e
# esquecer de atualizar aqui faz TODA chamada ser rejeitada como invalida.
TWILIO_URL_PUBLICA=http://localhost:8000
# So o teste desliga.
TWILIO_VALIDAR_ASSINATURA=true
WHATSAPP_HOST=127.0.0.1
WHATSAPP_PORTA=8000

# WhatsApp direto na Meta (Cloud API). Convive com a Twilio: cada caminho de
# entrada responde pelo seu próprio provedor, sem chave para escolher.
# Token do USUÁRIO DE SISTEMA — o temporário da tela de configuração expira em
# menos de 24h, e a Marina pararia de responder sozinha.
META_ACCESS_TOKEN=
# Configurações > Básico > Chave secreta do app. É com ela que a Meta assina cada
# chamada (X-Hub-Signature-256); sem ela, toda mensagem é recusada com 403.
META_APP_SECRET=
# Texto combinado com a Meta no aperto de mão do webhook. Longo e aleatório.
META_VERIFY_TOKEN=
META_API_VERSAO=v25.0
META_VALIDAR_ASSINATURA=true

# Apresentacao
TIMEZONE_EXIBICAO=America/Sao_Paulo
LOG_LEVEL=INFO
# Vazio manda o log para o terminal, o que mistura JSON no meio da conversa.
LOG_ARQUIVO=marina.log
